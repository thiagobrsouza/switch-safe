# Copie para .env e ajuste. O docker compose lê este arquivo automaticamente.

# Porta HTTP exposta pela aplicação (host e container)
APP_PORT=8080

# Fuso horário usado no agendamento (cron) e na exibição de datas
TZ=America/Sao_Paulo

# Defina true quando a aplicação estiver atrás de HTTPS (proxy reverso)
SESSION_COOKIE_SECURE=false

# Defina true se houver proxy reverso (nginx/traefik) repassando X-Forwarded-*
TRUST_PROXY=false

# Quantos switches são copiados em paralelo
BACKUP_WORKERS=4

LOG_LEVEL=INFO

# ---------- Módulo Firewalls (servidor FTP embutido) ----------
FTP_ENABLED=true
# Porta FTP exposta no host
FTP_PORT=21
# IP deste servidor como os FIREWALLS o enxergam (obrigatório para o modo passivo atravessar o Docker)
FTP_PUBLIC_HOST=
# Faixa de portas passivas (libere no firewall de rede; 10 portas = 10 envios simultâneos)
FTP_PASSIVE_PORTS=30000-30009
